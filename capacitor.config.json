{
  "appId": "com.zamvu.app",
  "appName": "Zamvu",
  "webDir": "www",
  "server": {
    "url": "https://zamvu.com",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0f5c35",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "apple": true,
        "facebook": false,
        "twitter": false
      }
    },
    "FirebaseMessaging": {
      "presentationOptions": ["alert", "badge", "sound"]
    }
  }
}
